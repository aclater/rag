# rag-ingest: connectors and Docling parsing; run on demand with `podman run`.
# Base pinned in deploy/images.env (UBI 10, Python 3.12 minimal).
ARG BASE
FROM ${BASE}
# CPU-only PyTorch for Docling's layout model; parsing needs no GPU.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.14.1" "torchvision==0.29.1"
# Heavy dependencies in their own layer, so source changes rebuild quickly.
RUN pip install --no-cache-dir "docling==2.131.0" "mcp==2.2.0" "httpx==0.28.1" \
      "psycopg[binary]==3.3.6" "pyyaml==6.0.3"
# Fetch Docling's models at build time so ingestion runs offline.
ENV HF_HOME=/opt/app-root/hf DOCLING_ARTIFACTS_PATH=/opt/app-root/docling-models
RUN docling-tools models download --output-dir "$DOCLING_ARTIFACTS_PATH" layout \
 && chmod -R g=u "$DOCLING_ARTIFACTS_PATH"
COPY --chown=1001:0 pyproject.toml README.md LICENSE /opt/app-root/src/rag/
COPY --chown=1001:0 src /opt/app-root/src/rag/src
RUN pip install --no-cache-dir --no-deps /opt/app-root/src/rag
ENV HF_HUB_OFFLINE=1
USER 1001
ENTRYPOINT ["rag"]
