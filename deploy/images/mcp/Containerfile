# rag-mcp: the retrieval tools (search, fetch, list_collections) over MCP.
# Base pinned in deploy/images.env (UBI 10, Python 3.12 minimal).
ARG BASE
FROM ${BASE}
RUN pip install --no-cache-dir "mcp==2.2.0" "httpx==0.28.1" "psycopg[binary]==3.3.6" \
      "pyyaml==6.0.3"
COPY --chown=1001:0 pyproject.toml README.md LICENSE /opt/app-root/src/rag/
COPY --chown=1001:0 src /opt/app-root/src/rag/src
RUN pip install --no-cache-dir --no-deps /opt/app-root/src/rag
USER 1001
EXPOSE 8090
ENTRYPOINT ["rag-mcp"]
