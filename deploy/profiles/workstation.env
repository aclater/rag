# 96 GB+ unified memory (e.g. Strix Halo) with the GPU allowed to map ~100 GB.
# gpt-oss-120b alone is 59 GiB; see docs/models.md for raising the GTT limit.
PROFILE=workstation
CHAT_MODEL_FILE=gpt-oss-120b-MXFP4.gguf
CHAT_MODEL_ID=gpt-oss-120b
CHAT_CTX=65536
EMBED_MODEL_FILE=granite-embedding-english-r2.f16.gguf
EMBED_MODEL_ID=granite-embedding-english-r2
EMBED_DIM=768
RERANK_MODEL_FILE=granite-embedding-reranker-english-r2-f16.gguf
RERANK_MODEL_ID=granite-embedding-reranker-english-r2
UI_PORT=3000
