# Like laptop, with Google Gemma 4 26B-A4B (QAT q4_0) as the chat model. 32 GB+ of
# GPU-addressable memory.
PROFILE=laptop-gemma
CHAT_MODEL_FILE=gemma-4-26B_q4_0-it.gguf
CHAT_MODEL_ID=gemma-4-26b-a4b
CHAT_CTX=32768
EMBED_MODEL_FILE=granite-embedding-english-r2.f16.gguf
EMBED_MODEL_ID=granite-embedding-english-r2
EMBED_DIM=768
RERANK_MODEL_FILE=granite-embedding-reranker-english-r2-f16.gguf
RERANK_MODEL_ID=granite-embedding-reranker-english-r2
UI_PORT=3000
